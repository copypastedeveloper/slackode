# Slack bot tokens (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# OpenCode server URL (the entrypoint starts it on this address)
OPENCODE_URL=http://127.0.0.1:4096

# Git repo URL — works with any provider (GitHub, GitLab, Bitbucket, self-hosted)
REPO_URL=https://github.com/your-org/your-repo.git

# Optional display name (derived from REPO_URL if not set)
# TARGET_REPO=your-org/your-repo

# Git PAT with repo read access — works with any provider's token
GIT_TOKEN=ghp_...

# LLM provider and model (see README for options)
PROVIDER=github-copilot
MODEL=claude-sonnet-4.6
# Optional cheaper model for scheduled jobs/watchers (defaults to MODEL).
# Bare model name inherits PROVIDER; use provider/model form to override both.
# JOBS_MODEL=claude-haiku-4.5
# Hard wall-clock timeout per job run in ms (default 900000 = 15 min)
# JOB_TIMEOUT_MS=900000

# Provider auth — set the one that matches your PROVIDER:
# github-copilot: run `opencode auth login`, copy gho_ token from auth.json
COPILOT_TOKEN=gho_...
# anthropic:       ANTHROPIC_API_KEY=sk-ant-...
# openai:          OPENAI_API_KEY=sk-...
# openrouter:      OPENROUTER_API_KEY=sk-or-...
# amazon-bedrock:  AWS_ACCESS_KEY_ID=..., AWS_SECRET_ACCESS_KEY=..., AWS_REGION=us-east-1
# google-vertex-ai: GOOGLE_CLOUD_PROJECT=..., GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

# Path to bot's SQLite DB (set by docker-compose, stored in opencode-data volume)
# SESSIONS_DB_PATH=/home/appuser/.local/share/opencode/sessions.db

# Encryption key for tool API keys stored in DB (optional — plaintext if not set)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CONFIG_ENCRYPTION_KEY=

# Comma-separated Slack user IDs for initial admins (bootstrapped on startup)
# Find user IDs in Slack profile > "..." > "Copy member ID"
# ADMIN_USERS=U12345678,U87654321

# OAuth redirect URI for MCP servers that use OAuth (required if using OAuth tools)
# Host public/oauth-callback.html on any static HTTPS host and set the URL here.
# OAUTH_REDIRECT_URI=https://yoursite.example.com/oauth-callback.html

# Google Docs sync — share docs with the service account to auto-sync as knowledge
# Path to a GCP service account JSON key (also used by google-vertex-ai provider)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Sync interval in milliseconds (default: 3600000 = 1 hour)
# GDOCS_SYNC_INTERVAL_MS=3600000

# Local-only: pin opencode to a specific version for `npm run dev:local`.
# Place the binary at .local/bin/opencode-<ver> and dev.sh will symlink it.
# Useful for reproducing a bug against an older version side-by-side with the
# system install. Defaults to the version dev.sh currently expects (see the script).
# OPENCODE_PIN=1.15.13
